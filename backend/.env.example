DATABASE_URL="file:./dev.db"
# Optional for local development. If unset or left as the example, a temporary
# secret is generated automatically. Set a real secret for production.
# JWT_SECRET="generate-a-unique-random-secret-at-least-32-characters"
FRONTEND_ORIGIN="http://localhost:3000"
PORT=4000
NODE_ENV="development"
# Gmail SMTP: use an app password (requires Google 2-Step Verification).
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER="your-address@gmail.com"
SMTP_PASS="your-gmail-app-password"
# Optional; defaults to SMTP_USER.
# MAIL_FROM="Savor <your-address@gmail.com>"
# Optional but required for photo-based AI nutrition estimates.
# OPENAI_API_KEY="your-server-side-openai-api-key"
# OPENAI_VISION_MODEL="gpt-4o-mini"
